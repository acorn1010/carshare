---
import '@fontsource-variable/archivo';
import '../styles/global.css';

type Props = {
  title: string;
};
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Rent a car by the hour from people nearby. A demo of an open-source reservation engine where double-booking is impossible by construction."
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='2' y='8' width='28' height='16' rx='4' fill='%2316714a'/%3E%3Crect x='5' y='11' width='22' height='10' rx='2' fill='none' stroke='%23f5f1e8' stroke-width='2'/%3E%3C/svg%3E"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
